import CatalanAnchor.IntervalScope

/-!
# A concrete 1000-place finite arithmetic certificate

The integer data are copied exactly from the C checker's certificate_1000.txt.
All finite arithmetic is checked by ordinary Lean proof terms.  The final
scope theorem in this module assumes only the displayed strict interval for
Catalan's constant.  No interval truth or irrationality statement is postulated.
-/

set_option maxRecDepth 100000
set_option maxHeartbeats 4000000
set_option exponentiation.threshold 10000

namespace CatalanAnchor
namespace Certificate1000

def lo : ℤ := 

def hi : ℤ := 

def A : ℤ := -

def B : ℤ := 

def bound : ℕ := 

def scale : ℕ := 10 ^ 1000

/-- The only analytic hypothesis of the concrete certificate theorem. -/
def Interval : Prop :=
  (lo : ℝ) / (scale : ℝ) < catalan ∧
    catalan < (hi : ℝ) / (scale : ℝ)

/-- Every sign, product, and comparison in the finite certificate is proved
by kernel-checked arithmetic, without native evaluation. -/
theorem checked : IntervalFormCheck lo hi scale bound A B := by
  constructor <;> norm_num [lo, hi, scale, bound, A, B]

/-- The saved denominator bound has 501 decimal digits. -/
theorem bound_decimal_size : 10 ^ 500 ≤ bound ∧ bound < 10 ^ 501 := by
  norm_num [bound]

end Certificate1000

/-- Concrete positive small linear form, conditional only on the exact
1000-place Catalan interval stated in `Certificate1000.Interval`. -/
theorem CATALAN_LINEAR_FORM_1000_OF_INTERVAL
    (hinterval : Certificate1000.Interval) :
    0 < (Certificate1000.A : ℝ) * catalan + (Certificate1000.B : ℝ) ∧
      (Certificate1000.A : ℝ) * catalan + (Certificate1000.B : ℝ) <
        1 / (Certificate1000.bound : ℝ) :=
  interval_form_check_sound catalan Certificate1000.lo Certificate1000.hi
    Certificate1000.scale Certificate1000.bound Certificate1000.A Certificate1000.B
    Certificate1000.checked hinterval.1 hinterval.2

/-- A finite exclusion through the 501-digit bound.  The interval hypothesis
is explicit; no global irrationality conclusion is made. -/
theorem CATALAN_SCOPE_1000_OF_INTERVAL
    (hinterval : Certificate1000.Interval) :
    ∀ q : ℚ, q.den ≤ Certificate1000.bound → (q : ℝ) ≠ catalan :=
  interval_form_denominator_scope catalan Certificate1000.lo Certificate1000.hi
    Certificate1000.scale Certificate1000.bound Certificate1000.A Certificate1000.B
    Certificate1000.checked hinterval.1 hinterval.2

/-- The same finite exclusion for the independently identified native scalar. -/
theorem NATIVE_CATALAN_SCOPE_1000_OF_INTERVAL
    (hinterval : Certificate1000.Interval) :
    ∀ q : ℚ, q.den ≤ Certificate1000.bound → (q : ℝ) ≠ nativeCatalan := by
  rw [CATALAN_NATIVE_IDENTIFIED]
  exact CATALAN_SCOPE_1000_OF_INTERVAL hinterval

end CatalanAnchor
